{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "pocadfcomfama"
		},
		"77Databricks77_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of '77Databricks77'"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureBlobStorage2_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage2'"
		},
		"AzureBlobStorage7_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage7'"
		},
		"AzureDatabricksDeltaLake1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLake1'"
		},
		"AzureDatabricksDeltaLake2_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLake2'"
		},
		"AzureDatabricksDeltaLakeFinal_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksDeltaLakeFinal'"
		},
		"bdcomfamaenSS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'bdcomfamaenSS'"
		},
		"newlsand_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'newlsand'"
		},
		"tokenfinalLS_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'tokenfinalLS'"
		},
		"linkedservibricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'linkedservibricks'"
		},
		"bdcomfamaenSS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "pocdbcomfama.database.windows.net"
		},
		"bdcomfamaenSS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "pocdbcomfama"
		},
		"bdcomfamaenSS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "logincomfama"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "pocadfcomfama_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"77Databricks77_accessToken": {
						"value": "[parameters('77Databricks77_accessToken')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureBlobStorage2_connectionString": {
						"value": "[parameters('AzureBlobStorage2_connectionString')]"
					},
					"AzureBlobStorage7_connectionString": {
						"value": "[parameters('AzureBlobStorage7_connectionString')]"
					},
					"AzureDatabricksDeltaLake1_accessToken": {
						"value": "[parameters('AzureDatabricksDeltaLake1_accessToken')]"
					},
					"AzureDatabricksDeltaLake2_accessToken": {
						"value": "[parameters('AzureDatabricksDeltaLake2_accessToken')]"
					},
					"AzureDatabricksDeltaLakeFinal_accessToken": {
						"value": "[parameters('AzureDatabricksDeltaLakeFinal_accessToken')]"
					},
					"bdcomfamaenSS_password": {
						"value": "[parameters('bdcomfamaenSS_password')]"
					},
					"newlsand_connectionString": {
						"value": "[parameters('newlsand_connectionString')]"
					},
					"tokenfinalLS_accessToken": {
						"value": "[parameters('tokenfinalLS_accessToken')]"
					},
					"linkedservibricks_accessToken": {
						"value": "[parameters('linkedservibricks_accessToken')]"
					},
					"bdcomfamaenSS_properties_typeProperties_server": {
						"value": "[parameters('bdcomfamaenSS_properties_typeProperties_server')]"
					},
					"bdcomfamaenSS_properties_typeProperties_database": {
						"value": "[parameters('bdcomfamaenSS_properties_typeProperties_database')]"
					},
					"bdcomfamaenSS_properties_typeProperties_userName": {
						"value": "[parameters('bdcomfamaenSS_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "pocadfcomfama_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'pocadfcomfama_ArmTemplate_0')]"
			]
		}
	]
}